# Copy this file to the plugin config directory and edit it:
#   herdr plugin config-dir tabnotes
#
# This file is sourced by the plugin, so it is shell code. Only put your own
# settings in it.

# Where note files live. Default: $HERDR_PLUGIN_STATE_DIR/notes
# NOTES_DIR="$HOME/notes/herdr"

# Width of the notes pane, in columns. Minimum 20. Default: 40
# NOTES_COLS=48

# Editor command. Empty means the bundled `nvim --clean -u init.vim`.
# NOTES_EDITOR="nvim"

# Set to 1 to load your normal Neovim config instead of the bundled minimal
# one. The tabnotes behavior (autosave, OSC 52 yanks, checkbox and screen-line
# mappings) is layered on top; your theme, statusline and options are kept.
# NOTES_USER_CONFIG=0

# Neovim colors. Defaults: light background + the built-in default scheme.
# NOTES_BACKGROUND="light"   # light or dark
# NOTES_COLORSCHEME="default"

# Set to 1 to enable spell checking in the notes buffer.
# NOTES_SPELL=0
